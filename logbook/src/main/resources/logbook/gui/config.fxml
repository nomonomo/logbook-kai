                                    <TableColumn fx:id="pluginLicense" prefWidth="120.0" text="ライセンス" />
                                    <TableColumn fx:id="pluginLocation" prefWidth="150.0" text="場所" />
                                </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
